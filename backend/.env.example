# PostgreSQL connection string (Neon). Get this from your Neon project dashboard -- prefer the
# pooled connection string for the Render web service. sslmode=require is mandatory for Neon.
DATABASE_URL=postgresql+psycopg://user:password@ep-example-12345.us-east-2.aws.neon.tech/campus_exchange?sslmode=require

# openssl rand -hex 32
SECRET_KEY=dev-secret-key-change-me

ACCESS_TOKEN_EXPIRE_MINUTES=1440
REMEMBER_ME_EXPIRE_MINUTES=43200

# Comma-separated list of allowed frontend origins. Replace the last two placeholders with your
# actual Vercel and Render domains once assigned.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://campus-exchange.vercel.app,https://campus-exchange-api.onrender.com
COOKIE_SECURE=false
# "lax" for local dev. Set to "none" in production (Render), since the Vercel frontend and Render
# backend are different domains -- a Lax cookie never gets attached to cross-site fetch requests,
# so every authenticated action (creating a listing, etc.) fails with "Not authenticated" even
# right after logging in. "none" requires COOKIE_SECURE=true.
COOKIE_SAMESITE=lax

# Cloudinary (avatar image storage). Get these from your Cloudinary dashboard.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
